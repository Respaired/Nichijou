{
  "version": "DaryaTitaNetDiT",
  "model": {
    "latent_size": 80,
    "norm_eps": 1e-06,
    "decoder": {
      "model_size": 1024,
      "num_layers": 16,
      "num_heads": 16,
      "intermediate_size": 4096,
      "patch_size": 2,
      "hourglass": {
        "enabled": true,
        "pre_layers": 2,
        "post_layers": 2
      }
    },
    "text_encoder": {
      "kind": "scratch",
      "vocab_size": 4200,
      "pad_token_id": 1,
      "pretrained_name": "jhu-clsp/mmBERT-base",
      "use_custom_tokenizer": true,
      "init_noise_std": 0.02,
      "model_size": 1024,
      "num_layers": 10,
      "num_heads": 16,
      "intermediate_size": 3072,
      "max_position_embeddings": 2048
    },
    "reference_projector": {
      "latent_dim": 80
    },
    "conditioning": {
      "timestep_embed_size": 512,
      "adaln_rank": 256
    }
  },
  "data": {
    "sample_rate": 44100,
    "codec_rate_hz": 21.5,
    "latent_dim": 80,
    "max_audio_seconds": 60.0,
    "max_latent_length": 1290,
    "max_text_length": 2048,
    "text_pad_id": 1,
    "latent_length_buckets": [
      670,
      1290
    ],
    "silence_latent_path": "assets/tts/silence.pt"
  }
}
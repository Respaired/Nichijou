{
  "version": "NichijouTitaNetDiT",
  "model": {
    "latent_size": 80,
    "norm_eps": 1e-06,
    "decoder": {
      "model_size": 1024,
      "num_layers": 16,
      "num_heads": 16,
      "intermediate_size": 4096,
      "patch_size": 2,
      "hourglass": {
        "enabled": true,
        "pre_layers": 2,
        "post_layers": 2
      }
    },
    "text_encoder": {
      "kind": "scratch",
      "vocab_size": 4200,
      "pad_token_id": 1,
      "pretrained_name": "jhu-clsp/mmBERT-base",
      "use_custom_tokenizer": true,
      "init_noise_std": 0.02,
      "model_size": 1024,
      "num_layers": 10,
      "num_heads": 16,
      "intermediate_size": 3072,
      "max_position_embeddings": 2048
    },
    "reference_projector": {
      "latent_dim": 80
    },
    "conditioning": {
      "timestep_embed_size": 512,
      "adaln_rank": 256
    }
  },
  "data": {
    "sample_rate": 44100,
    "codec_rate_hz": 21.5,
    "latent_dim": 80,
    "max_audio_seconds": 30,
    "max_latent_length": 670,
    "max_text_length": 512,
    "text_pad_id": 1,
    "latent_length_buckets": [
      670
    ]
  },
  "training": {
    "dtype": "float32",
    "compile": true,
    "batch_size": 80,
    "prefetch_factor": 2,
    "num_workers": 8,
    "grad_accum_steps": 3,
    "key_index_cache_dir": "runs/nichijou_base/key_indices",
    "optimizer": "adamw8bit",
    "lr": 0.0002,
    "muon_lr": 0.0001,
    "muon_adamw_lr": 0.0002,
    "muon_adjust_lr_fn": "match_rms_adamw",
    "weight_decay": 0.1,
    "muon_ns_steps": 5,
    "betas": [
      0.9,
      0.999
    ],
    "lr_schedule": "wsd",
    "warmup_steps": 10000,
    "wsd_decay_start": 350000,
    "wsd_decay_steps": 50000,
    "wsd_min_lr_ratio": 0.1,
    "max_steps": 524361,
    "grad_clip": 1.0,
    "ema_decay": 0.9999,
    "log_every": 100,
    "save_every": 5000,
    "keep_last_k": 5,
    "text_cond_drop_prob": 0.1,
    "speaker_cond_drop_prob": 0.1,
    "use_checkpoint": false,
    "seed": 42
  }
}
